{
  "routes": [
    { "route": "/manage", "redirect": "/manage/", "statusCode": 301 },
    { "route": "/book", "redirect": "/book/", "statusCode": 301 },
    { "route": "/booking", "redirect": "/booking/", "statusCode": 301 }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/api/*",
      "/_next/*",
      "/*.{css,js,png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,json,txt,xml}"
    ]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
